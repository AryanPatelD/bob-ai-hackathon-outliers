# ---------------------------------------------------------------------------
# GridWise AI — Environment Configuration
# Copy this file to .env and adjust values for your environment.
# ---------------------------------------------------------------------------

# Data directory for synthetic parquet files
DATA_DIR=src/data/synthetic

# Trained model artefact path
MODEL_PATH=src/ml/saved_models/load_forecast_xgb.json

# ---------------------------------------------------------------------------
# Spike detection thresholds (reserve margin as fraction of capacity)
# ---------------------------------------------------------------------------
SPIKE_CRITICAL_RESERVE=0.05    # < 5%  → CRITICAL
SPIKE_HIGH_RESERVE=0.10        # < 10% → HIGH
SPIKE_MEDIUM_RESERVE=0.20      # < 20% → MEDIUM
SPIKE_ABS_THRESHOLD_MW=1700    # Absolute load threshold → at least MEDIUM

DEFAULT_CAPACITY_MW=2600       # Fallback capacity when live data unavailable

# ---------------------------------------------------------------------------
# Anomaly detection thresholds
# ---------------------------------------------------------------------------
ANOMALY_CRITICAL_PERF_RATIO=0.50   # perf_ratio < 0.50 → CRITICAL candidate
ANOMALY_WARNING_PERF_RATIO=0.75    # perf_ratio < 0.75 → WARNING candidate
ANOMALY_CRITICAL_ABS_MW=5.0        # minimum absolute deviation for CRITICAL
ANOMALY_WARNING_ABS_MW=2.0         # minimum absolute deviation for WARNING
ANOMALY_MIN_EXPECTED_MW=2.0        # suppress alerts when expected < this (nighttime/calm)

# ---------------------------------------------------------------------------
# Root cause analysis thresholds
# ---------------------------------------------------------------------------
RCA_CLOUD_HIGH=60                  # % cloud cover → high-confidence cloud cause
RCA_CLOUD_MED=30                   # % cloud cover → moderate cloud cause
RCA_IRRADIANCE_LOW=200             # W/m² below which irradiance reduction is flagged
RCA_TEMP_DERATE=35                 # °C above which temperature derating is noted
RCA_WIND_CUT_IN=3.0               # m/s cut-in speed
RCA_WIND_RATED=12.0               # m/s rated speed
RCA_WIND_CUT_OUT=25.0             # m/s cut-out speed
RCA_WIND_LOW=5.0                   # m/s below which insufficient-wind cause applies
RCA_INSPECTION_THRESHOLD_MW=3.0   # unexplained loss threshold to recommend inspection
RCA_SENSOR_SUSPECT_RATIO=0.05     # perf_ratio below which sensor fault is suspected
